{
  "name": "mui-media-player",
  "version": "1.1.1",
  "description": "A production-grade, highly customizable media player library for React and MUI with VideoPlayer, AudioPlayer, MediaPlayer, MediaBar, MediaCenter, and comprehensive playlist support.",
  "type": "module",
  "main": "./dist/mui-media-player.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mui-media-player.es.js",
      "default": "./dist/mui-media-player.es.js"
    }
  },
  "keywords": [
    "react",
    "mui",
    "material-ui",
    "media",
    "player",
    "video",
    "audio",
    "playlist",
    "media-center",
    "media-bar",
    "video-player",
    "audio-player",
    "typescript"
  ],
  "author": "Ankit Shukla <4nkit5hukla@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/4nkit-5hukla/mui-media-player",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4nkit-5hukla/mui-media-player.git"
  },
  "bugs": {
    "url": "https://github.com/4nkit-5hukla/mui-media-player/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run test:run && vite build",
    "build:fast": "vite build",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^5.0.0 || ^6.0.0 || ^7.0.0 || ^9.0.0",
    "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.7",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "wavesurfer.js": "^8.0.3"
  }
}
